# Node >=22.9; copy to .env. Keep keys in the backend only.
HOST=127.0.0.1
PORT=3000

# Explicit Mock overrides a configured Key. Set false for real API calls.
AGENT_MOCK=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_MS=15000

# Trusted source = socket peer IP. Forwarded headers are ignored.
RATE_LIMIT=true
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DAILY_TOKENS=1000000

# Local single-process budget reservations, persisted in ignored data/private/.
# These are application estimates/allocations, not a provider billing cap.
BUDGET_ENABLED=true
BUDGET_DAILY_YUAN=5
MODEL_TEST_BUDGET_CNY=30
MODEL_CALL_RESERVE_CNY=0.05
# Optional absolute/relative ledger path. Default: data/private/agent-budget.json
AGENT_BUDGET_FILE=

# Leave blank if prices have not been verified for this account/model.
# Unknown actual cost stays null; the reservation is retained conservatively.
MODEL_INPUT_CNY_PER_MILLION=
MODEL_OUTPUT_CNY_PER_MILLION=
